# ==========================================
# CAMERA
# ==========================================
# rtsp = бодит камер (үндсэн). mp4 = зөвхөн development/test adapter.
CAMERA_SOURCE=rtsp

CAMERA_NAME=Factory-Camera-01

# !!! ӨӨРИЙН БОДИТ УТГААР СОЛИНО !!!
CAMERA_IP=192.168.38.159
CAMERA_RTSP_PORT=554
CAMERA_USERNAME=test
CAMERA_PASSWORD=Asd12345

CAMERA_CHANNEL=1
# 0 = main stream, 1 = sub stream
CAMERA_SUBTYPE=0

# DAHUA | HIKVISION | GENERIC_RTSP
CAMERA_TYPE=DAHUA

# GENERIC_RTSP үед бүтэн URL (заавал биш). {username} {password} {ip} {port} {channel} {subtype} placeholder дэмжинэ.
CAMERA_RTSP_URL_TEMPLATE=

# Зөвхөн CAMERA_SOURCE=mp4 үед
VIDEO_FILE_PATH=

# Reconnect (exponential backoff)
CAMERA_RETRY_DELAY=2
CAMERA_MAX_RETRY_DELAY=60
CAMERA_OPEN_TIMEOUT_MS=10000
CAMERA_READ_TIMEOUT_MS=10000

# ==========================================
# AI MODEL
# ==========================================
MODEL_PATH=./models/initial_model.pt
CONFIDENCE_THRESHOLD=0.50
# Хүнийг хүрээлэх нам босго (сул илэрсэн хүнд каск/хувцасны дүгнэлт хийхгүй)
PERSON_CONFIDENCE_THRESHOLD=0.30
IOU_THRESHOLD=0.45
INFERENCE_IMGSZ=640
# "" = auto. Apple Silicon: mps, NVIDIA: cuda:0
INFERENCE_DEVICE=

# Model-ийн class нэр canonical (person, helmet, no_helmet, work_uniform, no_work_uniform)-тэй
# таарахгүй бол энд хөрвүүлнэ. Жишээ:
# CLASS_MAPPING=Person:person,Hardhat:helmet,NO-Hardhat:no_helmet,Safety Vest:work_uniform,NO-Safety Vest:no_work_uniform
CLASS_MAPPING=

# ==========================================
# ZONE (FACTORY: дуулга+хувцас заавал | OFFICE: хувцас заавал, дуулга заавал биш)
# ==========================================
CAMERA_ZONE=FACTORY

# ==========================================
# VIOLATION
# ==========================================
VIOLATION_COOLDOWN_SECONDS=10
# Зөрчил сүүлийн WINDOW frame-ийн дор хаяж MIN_HITS-д илэрвэл баталгаажна (flicker-ээс хамгаална)
VIOLATION_CONFIRM_WINDOW=5
VIOLATION_CONFIRM_MIN_HITS=3
# Person tracker (frame хооронд нэг хүнд түр ID өгнө)
TRACK_IOU_THRESHOLD=0.25
TRACK_MAX_AGE_SECONDS=3

# ==========================================
# SNAPSHOT
# ==========================================
SNAPSHOT_JPEG_QUALITY=85
# Snapshot дээрх цагийн бүс (Монгол = 8)
SNAPSHOT_UTC_OFFSET_HOURS=8
# true = Supabase-д upload хийхийн зэрэгцээ ./snapshots дотор локал хуулбар хадгална
SNAPSHOT_SAVE_LOCAL=true
SNAPSHOT_LOCAL_DIR=./snapshots

# ==========================================
# DATABASE
# ==========================================
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# ==========================================
# SUPABASE
# ==========================================
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=violation-snapshots

# ==========================================
# BACKEND
# ==========================================
BACKEND_URL=http://localhost:8000
# backend/.env-тэй ИЖИЛ утга (ai-service -> backend дотоод дуудлага)
INTERNAL_API_KEY=CHANGE_ME
# DB-д шифрлэгдсэн камерын нууц үгийг тайлах түлхүүр (backend/.env-тэй ИЖИЛ)
CAMERA_SECRET_KEY=CHANGE_ME
# `serve` горим: DB-ийн камеруудыг хэдэн секунд тутам дахин унших
CAMERA_SYNC_INTERVAL_SECONDS=10

# ==========================================
# LOGGING
# ==========================================
LOG_LEVEL=INFO
LOG_DIR=./logs

# MediaMTX (камерын видеог browser-д WebRTC-ээр түгээнэ). `mediamtx infra/mediamtx.yml`
MEDIAMTX_ENABLED=true
MEDIAMTX_API_URL=http://127.0.0.1:9997
MEDIAMTX_RTSP_URL=rtsp://127.0.0.1:8554
