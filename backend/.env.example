# ==========================================
# DATABASE (Supabase PostgreSQL)
# Нууц үгэнд ? @ $ & : / байвал URL-encode хий (жишээ: ? -> %3F)
# ==========================================
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# ==========================================
# SUPABASE
# ==========================================
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=violation-snapshots
SIGNED_URL_EXPIRE_SECONDS=3600

# ==========================================
# SECRETS (хуваалцахгүй, git-д оруулахгүй)
# Үүсгэх:
#   CAMERA_SECRET_KEY : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   JWT_SECRET / INTERNAL_API_KEY : python -c "import secrets; print(secrets.token_urlsafe(48))"
# CAMERA_SECRET_KEY ба INTERNAL_API_KEY нь ai-service/.env-тэй ИЖИЛ байх ёстой.
# ==========================================
CAMERA_SECRET_KEY=CHANGE_ME
JWT_SECRET=CHANGE_ME
INTERNAL_API_KEY=CHANGE_ME
JWT_EXPIRE_MINUTES=480

# ==========================================
# API
# ==========================================
CORS_ORIGINS=http://localhost:3000
# HTTPS дээр заавал true
COOKIE_SECURE=false
LOG_LEVEL=INFO
LOG_DIR=./logs

# Browser-ийн холбогдох MediaMTX WebRTC хаяг (production дээр https домэйн)
MEDIAMTX_PUBLIC_URL=http://localhost:8889
STREAM_TOKEN_EXPIRE_SECONDS=120

# ==========================================
# CLOUDFLARE TUNNEL (Vercel dashboard -> энэ Mac). worker.py автоматаар асаана.
# - Токенгүй (анхдагч): quick tunnel. Хаяг нь Supabase Storage-ийн public runtime-config/endpoints.json-д
#   нийтлэгдэж, Vercel (BACKEND_REGISTRY_URL) тэндээс уншина. MEDIAMTX_PUBLIC_URL-г worker өөрөө тохируулна.
# - Өөрийн домэйнтэй бол: Zero Trust -> Networks -> Tunnels: api.<домэйн> -> http://localhost:8001,
#   video.<домэйн> -> http://localhost:8889, токеноо энд тавиад MEDIAMTX_PUBLIC_URL=https://video.<домэйн>.
# - CLOUDFLARE_TUNNEL=off: зөвхөн local.
# Production: CORS_ORIGINS=https://<vercel-домэйн>, COOKIE_SECURE=true, APP_ENV=production
# Supabase pooler: session (5432) нь 15 холболтоор хязгаарлагддаг тул transaction pooler (6543) ашиглана.
# ==========================================
CLOUDFLARE_TUNNEL_TOKEN=

# Snapshot зураг + зөрчлийг энэ хугацаа (минут) өнгөрмөгц автоматаар устгана. 0 = хэзээ ч устгахгүй. 10080 = 7 хоног
SNAPSHOT_RETENTION_MINUTES=10080
